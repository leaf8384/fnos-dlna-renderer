#!/bin/bash
# 安装前：补齐 GStreamer 运行库，生成默认配置
#
# 依赖故意不写进 manifest 的依赖字段，而是在这里按需 apt 安装：
# 飞牛本体就是 Debian，宿主已有大部分 GStreamer 组件，重复装一遍最省事。

set -u

APPNAME="dlna-renderer"

: "${TRIM_PKGVAR:=/vol1/@appdata/${APPNAME}}"

VAR="${TRIM_PKGVAR}"
CONF="${VAR}/renderer.conf"
LOG="${VAR}/install.log"

mkdir -p "$VAR" 2>/dev/null

log() {
	printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$LOG" 2>/dev/null
}

log "install_init 开始"

# ---- 依赖 -------------------------------------------------------------
# libupnp13 是 gmediarender 的硬依赖（ldd 能看到 libupnp.so.13），
# alsa-utils 提供 aplay —— 设置页枚举声卡和放测试音都用它。
# 这两个都不是「顺手带上」的：飞牛本体不一定有，缺了要么起不来，要么设置页声卡列表是空的。
NEED=""
for pkg in libupnp13 alsa-utils gstreamer1.0-alsa gstreamer1.0-plugins-base \
	gstreamer1.0-plugins-good gstreamer1.0-plugins-ugly; do
	dpkg -s "$pkg" >/dev/null 2>&1 || NEED="$NEED $pkg"
done

if [ -n "$NEED" ]; then
	log "缺少依赖:$NEED，开始安装"
	export DEBIAN_FRONTEND=noninteractive
	apt-get update -qq >>"$LOG" 2>&1 || log "apt-get update 失败，仍尝试安装"
	if apt-get install -y -qq $NEED >>"$LOG" 2>&1; then
		log "依赖安装完成"
	else
		log "依赖安装失败。应用能装上但可能没有声音，请手动执行:"
		log "  apt install$NEED"
	fi
else
	log "依赖已满足"
fi

# ---- 默认配置 ---------------------------------------------------------
if [ ! -f "$CONF" ]; then
	IFACE=$(ip -4 route show default 2>/dev/null |
		awk '{ for (n = 1; n <= NF; n++) if ($n == "dev") { print $(n + 1); exit } }')
	CARD=$(aplay -l 2>/dev/null | sed -n 's/^card [0-9]*: \([^ ]*\) \[.*/\1/p' | head -1)
	# 优先 plug:dmix：调音量的提示音要和音乐同时出声，dmix 才允许第二个客户端。
	# plughw 是独占的，第二个打开会 Device or resource busy。
	if aplay -L 2>/dev/null | grep -qx 'plug:dmix'; then
		AUDIODEV="plug:dmix"
	else
		AUDIODEV="plughw:CARD=${CARD:-PCH},DEV=0"
	fi

	cat >"$CONF" <<EOF
# dlna-renderer 配置
# 推荐用设置界面改（应用中心 → 打开）：http://<NAS 地址>:8790
# 手改也可以，改完在应用中心停用再启用。

# 设备唯一标识。手机靠它认"这是同一台设备"，改名千万别动它，
# 否则手机会多出一条幽灵设备记录。留空则由 gmediarender 用自己的默认值。
UDN="uuid:GMediaRender-1_0-000-000-002"

# 手机投屏列表里显示的名字，可以用中文
FRIENDLY_NAME=Marshall

# 绑定网卡。留空则自动探测默认路由出口网卡。
# 多网卡或改了网络之后如果手机搜不到设备，先来这里确认。
IFACE=${IFACE}

# ALSA 输出设备。留空则自动探测。
# plug:dmix 是 ALSA 的软件混音：允许多个客户端同时出声，手机调音量的
# 提示音才能和音乐混在一起。换成 plughw:... 会让提示音失效（音乐照常）。
# 查询可用设备：aplay -L
AUDIODEV=${AUDIODEV}
EOF
	log "已生成默认配置 $CONF（网卡=${IFACE:-自动} 声卡=${AUDIODEV}）"
else
	log "配置已存在，保留不动"
fi

log "install_init 结束"
exit 0
