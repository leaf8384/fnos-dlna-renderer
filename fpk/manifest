appname                    = dlna-renderer
version                    = 1.1.0
display_name               = DLNA 音频桥
desc                       = 把 NAS 变成 DLNA/UPnP 音频渲染器：网易云、QQ音乐、酷狗等 App 的「投屏」列表里会直接出现这台设备，点一下就把声音从 NAS 的 3.5mm 或 HDMI 口推给音箱。自带设置界面，可改广播名（支持中文）、切换声卡和网卡、播放测试音。已修复网易云连续切歌、暂停后切歌、Seek 紧跟换流导致的无声与进度冻结问题，并记忆上次音量。需要机器有声卡输出，并接上音箱功放。
platform                   = x86
source                     = thirdparty
maintainer                 = 猫不理叶
maintainer_url             =
distributor                = 猫不理叶
distributor_url            =
os_min_version             = 1.0.0
checkport                  = false
disable_authorization_path = false
service_port               = 8790
changelog                  = 1.1.0：新增网页设置界面（应用中心「打开」进入），可改广播名/声卡/网卡，带测试音与保存生效。1.0.1：修复中文设备名无法启动（飞牛环境无 LANG，GLib 按 locale 转 argv 时落到 C locale，报 Invalid byte sequence）。1.0.0：首个版本，gmediarender 0.3.1 + 切歌补丁 + 音量持久化。
