+/*
+ * NetEase Cloud Music selects a track with SetAVTransportURI and expects the
+ * renderer to start it implicitly - it never follows up with Play - and it
+ * fires several SetAVTransportURI in a row when the user skips through a
+ * playlist. Re-arming the playbin for every single one of those is what
+ * breaks playback:
+ *
+ *  - each PLAYING->READY transition aborts the previous stream's HTTP
+ *    connection, and gstsouphttpsrc reports that abort as a bus error
+ *    ("Could not establish connection to server" / "Internal data stream
+ *    error"). The message is delivered *after* the next URI has been
+ *    installed, so it hits a freshly prerolling pipeline and leaves it
+ *    dead: silence, ALSA sink closed, UPnP still claiming PLAYING.
+ *  - a state transition that is still on its way must not be interrupted,
+ *    otherwise the preroll is thrown away and the pipeline never settles.
+ *
+ * So: coalesce the burst into one rebuild, ignore the teardown noise, and
+ * verify afterwards that audio really advances. Recovering through NULL is
+ * the only reliable way back from a half-torn-down playbin.
+ *
+ * Note on locking: libupnp serves SOAP actions from worker threads while the
+ * timers below run in the GLib main loop. The lock therefore only guards the
+ * bookkeeping variables - GStreamer is never called with it held.
+ */
+static gboolean uri_switch_in_flight(void) {
+	return uri_switch_timer_ != 0 || uri_watchdog_timer_ != 0;
+}
+
+/* Mark the moment a stream was (re)started. An end-of-stream that arrives
+ * shortly afterwards cannot belong to it - it is the stream we just replaced
+ * still draining - and must not be reported as a stop. */
+static void uri_switch_touch_applied(void) {
+	uri_switch_applied_us_ = g_get_monotonic_time();
+}
+
+static void uri_switch_set_applied(const char *uri) {
+	if (uri_applied_ != NULL && uri != NULL && strcmp(uri_applied_, uri) == 0)
+		return;
+	g_free(uri_applied_);
+	uri_applied_ = uri ? g_strdup(uri) : NULL;
+}
+
+static gboolean uri_switch_eos_is_stale(void) {
+	/* A new uri is already queued, so this end-of-stream belongs to the
+	 * stream that is about to be replaced. */
+	if (uri_switch_timer_ != 0)
+		return TRUE;
+	if (gsuri_ == NULL || !uri_switch_wants_play_ ||
+	    uri_switch_applied_us_ == 0)
+		return FALSE;
+	return g_get_monotonic_time() - uri_switch_applied_us_ <
+	       G_USEC_PER_SEC * 5 / 2;
+}
+
+static void uri_switch_cancel_watchdog(void) {
+	if (uri_watchdog_timer_ != 0) {
+		g_source_remove(uri_watchdog_timer_);
+		uri_watchdog_timer_ = 0;
+	}
+	uri_watchdog_stage_ = 0;
+	uri_watchdog_extensions_ = 0;
+	uri_watchdog_probes_ = 0;
+	uri_watchdog_resumes_ = 0;
+	uri_watchdog_pos_ = -1;
+}
+
+static void uri_switch_cancel(void) {
+	if (uri_switch_timer_ != 0) {
+		g_source_remove(uri_switch_timer_);
+		uri_switch_timer_ = 0;
+	}
+	uri_switch_settle_retries_ = 0;
+	uri_switch_cancel_watchdog();
+}
+
+/* Take a private copy of the current request, so that the callbacks can work
+ * with stable data while libupnp threads keep rewriting the globals. */
+static char *uri_switch_snapshot(gboolean *want_play) {
+	char *uri;
+	g_mutex_lock(&uri_switch_lock_);
+	uri = gsuri_ ? g_strdup(gsuri_) : NULL;
+	if (want_play)
+		*want_play = uri_switch_wants_play_;
+	g_mutex_unlock(&uri_switch_lock_);
+	return uri;
+}
+
+static gboolean uri_switch_apply(gpointer data);
+static gboolean uri_switch_watchdog(gpointer data);
+
+/* Push uri into the playbin from scratch. Going through NULL throws away
+ * every element of the previous pipeline, which is the only state from which
+ * a half-torn-down playbin comes back to life reliably. */
+static void uri_switch_restart(const char *why, const char *uri,
+			       gboolean want_play) {
+	const GstState target = want_play ? GST_STATE_PLAYING : GST_STATE_PAUSED;
+	Log_info("gstreamer", "Restarting playbin (%s) '%s' -> state %d",
+		 why, uri ? uri : "(null)", (int)target);
+	gst_element_set_state(player_, GST_STATE_NULL);
+	if (gst_element_set_state(player_, GST_STATE_READY) ==
+	    GST_STATE_CHANGE_FAILURE) {
+		Log_error("gstreamer", "READY failed while restarting playbin");
+		return;
+	}
+	if (uri != NULL) {
+		g_object_set(G_OBJECT(player_), "uri", uri, NULL);
+		uri_switch_set_applied(uri);
+	}
+	if (audio_sink_element_ != NULL)
+		g_object_set(G_OBJECT(player_), "audio-sink",
+			     audio_sink_element_, NULL);
+	if (gst_element_set_state(player_, target) ==
+	    GST_STATE_CHANGE_FAILURE) {
+		Log_error("gstreamer",
+			  "setting state failed while restarting playbin");
+	} else {
+		uri_switch_eos_ = FALSE;
+		uri_switch_touch_applied();
+	}
+}
+
+static void uri_switch_arm_watchdog(void) {
+	uri_switch_cancel_watchdog();
+	uri_watchdog_timer_ = g_timeout_add(URI_WATCHDOG_MS,
+					 uri_switch_watchdog, NULL);
+}
+
+static void uri_switch_recover(const char *why) {
+	char *uri;
+	gboolean want_play = FALSE;
+
+	if (uri_switch_restarts_ >= URI_WATCHDOG_MAX_RESTART) {
+		Log_error("gstreamer", "Playbin not recoverable (%s); giving up",
+			  why);
+		return;
+	}
+	uri_switch_restarts_++;
+	uri = uri_switch_snapshot(&want_play);
+	uri_switch_cancel_watchdog();
+	uri_switch_restart(why, uri, want_play);
+	g_free(uri);
+	uri_switch_arm_watchdog();
+}
+
+static gboolean uri_switch_watchdog(gpointer data) {
+	gint64 pos = -1;
+	GstState state = GST_STATE_NULL;
+	GstState pending = GST_STATE_VOID_PENDING;
+	gboolean want_play = FALSE;
+	char *uri;
+
+	(void)data;
+	uri_watchdog_timer_ = 0;
+
+	if (player_ == NULL || uri_switch_timer_ != 0)
+		return G_SOURCE_REMOVE;
+
+	uri = uri_switch_snapshot(&want_play);
+	if (uri == NULL) {
+		g_free(uri);
+		return G_SOURCE_REMOVE;
+	}
+	g_free(uri);
+
+	gst_element_get_state(player_, &state, &pending, 0);
+
+	if (uri_watchdog_stage_ == 0) {
+		const GstState wanted = want_play ? GST_STATE_PLAYING
+						  : GST_STATE_PAUSED;
+		/* Settled in pause although playback was asked for: a full
+		 * rebuild would cause a needless gap, simply resume. */
+		if (want_play && state == GST_STATE_PAUSED &&
+		    pending == GST_STATE_VOID_PENDING &&
+		    uri_watchdog_resumes_++ < 2) {
+			Log_info("gstreamer",
+				 "Settled in pause although play was requested; resuming");
+			gst_element_set_state(player_, GST_STATE_PLAYING);
+			uri_watchdog_timer_ =
+			    g_timeout_add(URI_WATCHDOG_CONFIRM_MS,
+					  uri_switch_watchdog, NULL);
+			return G_SOURCE_REMOVE;
+		}
+		if (state != wanted) {
+			if (pending == wanted &&
+			    uri_watchdog_extensions_ < URI_WATCHDOG_MAX_EXT) {
+				uri_watchdog_extensions_++;
+				Log_info("gstreamer",
+					 "Preroll still in flight (%d/%d); keep waiting",
+					 uri_watchdog_extensions_,
+					 URI_WATCHDOG_MAX_EXT);
+				uri_watchdog_timer_ =
+				    g_timeout_add(URI_WATCHDOG_MS,
+						  uri_switch_watchdog, NULL);
+				return G_SOURCE_REMOVE;
+			}
+			Log_info("gstreamer",
+				 "Unexpected state %d (pending %d, wanted %d)",
+				 (int)state, (int)pending, (int)wanted);
+			uri_switch_recover("wrong-state");
+			return G_SOURCE_REMOVE;
+		}
+		if (!want_play) {
+			/* Paused is a settled, legitimate state. */
+			uri_switch_restarts_ = 0;
+			return G_SOURCE_REMOVE;
+		}
+		/* The state alone is not enough: a playbin whose sink is gone stays
+		 * in PLAYING while the position never moves. Check the clock too. */
+		if (gst_element_query_position(player_, GST_FORMAT_TIME, &pos))
+			uri_watchdog_pos_ = pos;
+		else
+			uri_watchdog_pos_ = -1;
+		uri_watchdog_stage_ = 1;
+		uri_watchdog_timer_ = g_timeout_add(URI_WATCHDOG_CONFIRM_MS,
+						    uri_switch_watchdog, NULL);
+		return G_SOURCE_REMOVE;
+	}
+
+	/* stage 1: confirm that the stream is really moving. A single stalled
+	 * sample is no proof of a dead pipeline - a network stall or a failed
+	 * query looks exactly the same - so give it a couple more chances
+	 * before throwing the stream away. */
+	if (uri_watchdog_pos_ >= 0 &&
+	    gst_element_query_position(player_, GST_FORMAT_TIME, &pos) &&
+	    pos > uri_watchdog_pos_ + 200 * GST_MSECOND) {
+		uri_switch_restarts_ = 0;
+		return G_SOURCE_REMOVE;
+	}
+	if (uri_watchdog_probes_++ < 2) {
+		Log_info("gstreamer",
+			 "No progress yet (%" PRId64 " -> %" PRId64 "); re-checking",
+			 (gint64)uri_watchdog_pos_, (gint64)pos);
+		uri_watchdog_timer_ = g_timeout_add(URI_WATCHDOG_CONFIRM_MS,
+						    uri_switch_watchdog, NULL);
+		return G_SOURCE_REMOVE;
+	}
+	Log_info("gstreamer", "Position not advancing (%" PRId64 " -> %" PRId64 ")",
+		 (gint64)uri_watchdog_pos_, (gint64)pos);
+	uri_switch_recover("stalled");
+	return G_SOURCE_REMOVE;
+}
+
+static gboolean uri_switch_apply(gpointer data) {
+	GstState state = GST_STATE_NULL;
+	GstState pending = GST_STATE_VOID_PENDING;
+	GstState target;
+	gboolean want_play = FALSE;
+	char *uri;
+
+	(void)data;
+	uri_switch_timer_ = 0;
+	if (player_ == NULL)
+		return G_SOURCE_REMOVE;
+
+	uri = uri_switch_snapshot(&want_play);
+	if (uri == NULL) {
+		/* URI cleared: nothing left to play. */
+		uri_switch_cancel_watchdog();
+		gst_element_set_state(player_, GST_STATE_READY);
+		g_free(uri);
+		return G_SOURCE_REMOVE;
+	}
+
+	gst_element_get_state(player_, &state, &pending, 0);
+	if (pending != GST_STATE_VOID_PENDING && state != GST_STATE_PLAYING) {
+		/* A transition is still in flight. If it belongs to the uri we
+		 * are about to install, give it a chance to settle; if it belongs
+		 * to an older request, nobody is waiting for it and waiting would
+		 * only delay the new track. */
+		const gboolean own = (uri_applied_ != NULL &&
+				      strcmp(uri_applied_, uri) == 0);
+		if (own && uri_switch_settle_retries_++ < 15) {
+			uri_switch_timer_ = g_timeout_add(120, uri_switch_apply,
+							  NULL);
+			g_free(uri);
+			return G_SOURCE_REMOVE;
+		}
+		Log_info("gstreamer", "%s; forcing restart",
+			 own ? "Pipeline never settled"
+			     : "Pending transition belongs to an older uri");
+		uri_switch_settle_retries_ = 0;
+		uri_switch_restart("settle-timeout", uri, want_play);
+		uri_switch_arm_watchdog();
+		g_free(uri);
+		return G_SOURCE_REMOVE;
+	}
+	uri_switch_settle_retries_ = 0;
+	uri_switch_restarts_ = 0;
+
+	target = want_play ? GST_STATE_PLAYING : GST_STATE_PAUSED;
+	Log_info("gstreamer", "Switching to '%s' (from %d, target %d)",
+		 uri, (int)state, (int)target);
+
+	if (gst_element_set_state(player_, GST_STATE_READY) ==
+	    GST_STATE_CHANGE_FAILURE) {
+		Log_error("gstreamer", "READY failed while switching uri");
+		uri_switch_restart("ready-failed", uri, want_play);
+	} else {
+		g_object_set(G_OBJECT(player_), "uri", uri, NULL);
+		uri_switch_set_applied(uri);
+		if (gst_element_set_state(player_, target) ==
+		    GST_STATE_CHANGE_FAILURE) {
+			Log_error("gstreamer",
+				  "setting state %d failed after uri switch",
+				  (int)target);
+			uri_switch_restart("state-failed", uri, want_play);
+		}
+	}
+	uri_switch_eos_ = FALSE;
+	uri_switch_touch_applied();
+	uri_switch_arm_watchdog();
+	g_free(uri);
+	return G_SOURCE_REMOVE;
+}
