+/* Volume that the user last chose. upnp_control_init() can only seed from the
+ * output sink, which is at full scale on every fresh start, so without this
+ * the renderer always comes up at 100% and the control point hears full
+ * volume until somebody touches the slider.
+ *
+ * Package managers (the fpk wrapper in this repo) set GMR_VOLUME_STATE so the
+ * file can live on the data volume instead of the system partition. */
+#define VOLUME_STATE_FILE_DEFAULT "/var/lib/gmediarender/volume.state"
+
+static const char *volume_state_file(void) {
+	const char *override_path = getenv("GMR_VOLUME_STATE");
+
+	return (override_path != NULL && *override_path != '\0')
+		       ? override_path
+		       : VOLUME_STATE_FILE_DEFAULT;
+}
+
+static void volume_state_save(int level) {
+	FILE *f = fopen(volume_state_file(), "w");
+	if (f == NULL) {
+		return;
+	}
+	fprintf(f, "%d\n", level);
+	fclose(f);
+}
+
+/* Returns the stored level, or -1 if there is nothing usable. */
+static int volume_state_restore(void) {
+	char line[16];
+	FILE *f = fopen(volume_state_file(), "r");
+	int level = -1;
+
+	if (f == NULL) {
+		return -1;
+	}
+	if (fgets(line, sizeof(line), f) != NULL) {
+		level = atoi(line);
+	}
+	fclose(f);
+	if (level < volume_range.min || level > volume_range.max) {
+		return -1;
+	}
+	return level;
+}
+
+static void volume_apply_level(int level, const char *why) {
+	const float decibel = volume_level_to_decibel(level);
+	char volume[16];
+	char db_volume[16];
+
+	snprintf(volume, sizeof(volume), "%d", level);
+	snprintf(db_volume, sizeof(db_volume), "%d", (int) (256 * decibel));
+	Log_info("control", "%s: level #%d (%.2fdb)", why, level, decibel);
+
+	change_volume(volume, db_volume);
+	output_set_volume(exp(decibel / 20 * log(10)));
+	set_mute_toggle(level == 0);
+}
+
 void upnp_control_init(struct upnp_device *device) {
 	struct service *service = upnp_control_get_service();
+	const int saved_level = volume_state_restore();
 
