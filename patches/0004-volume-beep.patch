+/* A volume-key press sends one SetVolume, a slider drag sends a burst of
+ * them. Waiting for the value to settle turns that into one beep instead
+ * of a machine gun. */
+#define VOLUME_BEEP_IDLE_MS 400
+
+static guint volume_beep_timer_ = 0;
+static int volume_beep_level_ = -1;
+
+static gboolean volume_beep_fire(gpointer data) {
+	(void)data;
+	volume_beep_timer_ = 0;
+	if (!upnp_transport_is_playing()) {
+		return G_SOURCE_REMOVE;
+	}
+	/* Full scale gets a distinctly higher tone, so "max" is audible
+	 * without looking at the phone. */
+	output_beep(volume_beep_level_ >= 100 ? 1320 : 880, 70);
+	return G_SOURCE_REMOVE;
+}
+
 static void change_volume(const char *volume, const char *db_volume) {
 	replace_var(CONTROL_VAR_VOLUME, volume);
 	replace_var(CONTROL_VAR_VOLUME_DB, db_volume);
 	volume_state_save(atoi(volume));
+
+	volume_beep_level_ = atoi(volume);
+	if (volume_beep_timer_ != 0) {
+		g_source_remove(volume_beep_timer_);
+		volume_beep_timer_ = 0;
+	}
+	volume_beep_timer_ = g_timeout_add(VOLUME_BEEP_IDLE_MS,
+					   volume_beep_fire, NULL);
 }
 
