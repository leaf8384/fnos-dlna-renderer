+/* ---- confirmation tone -------------------------------------------------
+ *
+ * The phone never reports back which volume its keys just set on us, so a
+ * short tone is the only feedback there is.
+ *
+ * This deliberately does NOT touch the music pipeline. An earlier attempt
+ * bolted an extra audiotestsrc into it through an audiomixer; audiomixer
+ * waits for *every* input pad to preroll before it outputs anything, and a
+ * live test source produces nothing while in PAUSED, so playbin stayed
+ * stuck in preroll and no music ever played. Instead the tone gets a
+ * throwaway pipeline of its own that shares the sound card with the music
+ * through ALSA dmix. No shared state, nothing to un-wire, and if it fails
+ * the music is untouched.
+ *
+ * The waveform is generated in C (not by audiotestsrc) so the attack and
+ * release can be faded in/out: a hard sine start/stop clicks audibly on a
+ * speaker even when the length is an integral number of periods, because
+ * the signal still jumps from silence to a full-amplitude sample. Fading
+ * 4 ms at each end removes the click and makes the tone sound like a soft
+ * "ting" instead of a square-edged "beep".
+ */
+
+#define BEEP_RATE 44100
+
+/* Frequencies that divide 44100 exactly, so the whole-period trick lines
+ * up on a sample boundary and there is no discontinuity at the loop point.
+ * A fundamental plus a 3:2 fifth sounds like a chime; the "full" variant is
+ * one octave up, clearly distinguishable from the normal one. */
+typedef struct {
+	double f1;	/* fundamental */
+	double f2;	/* 3:2 fifth above the fundamental */
+} beep_tone;
+
+static const beep_tone BEEP_NORMAL = { 882.0, 1323.0 };
+static const beep_tone BEEP_FULL   = { 1764.0, 2646.0 };
+
+typedef struct {
+	const beep_tone *tone;
+	int    duration_ms;
+	double volume;	/* linear gain applied to the tone itself */
+} beep_job;
+
+static GstElement *beep_make(const char *factory) {
+	GstElement *e = gst_element_factory_make(factory, NULL);
+	if (e == NULL) {
+		Log_info("gstreamer", "beep: element '%s' missing", factory);
+	}
+	return e;
+}
+
+static void beep_unref_all(GstElement *a, GstElement *b, GstElement *c,
+			   GstElement *d, GstElement *e) {
+	if (a != NULL) gst_object_unref(a);
+	if (b != NULL) gst_object_unref(b);
+	if (c != NULL) gst_object_unref(c);
+	if (d != NULL) gst_object_unref(d);
+	if (e != NULL) gst_object_unref(e);
+}
+
+/* Build the stereo PCM for one chime. Both channels carry the same signal
+ * (a fundamental plus a softer fifth); the whole thing is faded in/out by
+ * FADE_MS at each end. Returns a newly allocated GstBuffer. */
+#define BEEP_FADE_MS 4
+
+static GstBuffer *beep_build_buffer(const beep_tone *tone, int duration_ms) {
+	int n = (int) ((double) BEEP_RATE * duration_ms / 1000.0 + 0.5);
+	int fade = (int) ((double) BEEP_RATE * BEEP_FADE_MS / 1000.0 + 0.5);
+	gint16 *pcm;
+	GstBuffer *buf;
+	GstMapInfo map;
+	int i;
+	double a1 = 0.6;	/* fundamental */
+	double a2 = 0.25;	/* fifth, quieter so it just colours */
+
+	if (fade < 1) fade = 1;
+	if (n < 2 * fade) n = 2 * fade;
+
+	buf = gst_buffer_new_allocate(NULL, (gsize) n * 2 * 2, NULL);
+	if (!gst_buffer_map(buf, &map, GST_MAP_WRITE)) {
+		gst_buffer_unref(buf);
+		return NULL;
+	}
+	pcm = (gint16 *) map.data;
+
+	for (i = 0; i < n; i++) {
+		double env = 1.0;
+		double v;
+		if (i < fade) {
+			env = (double) i / fade;
+		} else if (i >= n - fade) {
+			env = (double) (n - 1 - i) / fade;
+		}
+		v = env * (a1 * sin(2.0 * G_PI * tone->f1 * i / BEEP_RATE)
+			   + a2 * sin(2.0 * G_PI * tone->f2 * i / BEEP_RATE));
+		/* clamp into 16-bit, then mirror to both channels */
+		{
+			gint16 s;
+			if (v > 1.0) v = 1.0;
+			if (v < -1.0) v = -1.0;
+			s = (gint16) (v * 32767.0);
+			pcm[2 * i] = s;
+			pcm[2 * i + 1] = s;
+		}
+	}
+	gst_buffer_unmap(buf, &map);
+	return buf;
+}
+
+static gpointer beep_thread(gpointer data) {
+	beep_job *job = (beep_job *) data;
+	GstElement *pipeline = NULL, *src = NULL, *conv = NULL,
+		   *vol = NULL, *sink = NULL;
+	GstBus *bus = NULL;
+	GstMessage *msg = NULL;
+	GstCaps *caps;
+	GstBuffer *buf = NULL;
+	gboolean in_bin = FALSE;
+	gboolean got_eos = FALSE;
+
+	buf = beep_build_buffer(job->tone, job->duration_ms);
+	if (buf == NULL) {
+		goto done;
+	}
+
+	pipeline = beep_make("pipeline");
+	src  = beep_make("appsrc");
+	conv = beep_make("audioconvert");
+	vol  = beep_make("volume");
+	sink = beep_make("alsasink");
+	if (pipeline == NULL || src == NULL || conv == NULL ||
+	    vol == NULL || sink == NULL) {
+		goto done;
+	}
+
+	/* We generate exactly what we want: S16LE / stereo / 44100. Pinning the
+	 * caps downstream means appsrc feeds the data through unchanged — no
+	 * resample, no bit-depth change, nothing that could colour the music.
+	 * (appsasink's device is plug:dmix, which is already pinned to 44100 in
+	 * /etc/asound.conf, so the two agree and there is no conversion.) */
+	caps = gst_caps_new_simple("audio/x-raw",
+				   "format", G_TYPE_STRING, "S16LE",
+				   "layout", G_TYPE_STRING, "interleaved",
+				   "rate", G_TYPE_INT, BEEP_RATE,
+				   "channels", G_TYPE_INT, 2,
+				   NULL);
+	g_object_set(src, "caps", caps, NULL);
+	gst_caps_unref(caps);
+	g_object_set(src, "format", GST_FORMAT_TIME, NULL);
+	g_object_set(vol, "volume", job->volume, NULL);
+	if (audio_device != NULL) {
+		g_object_set(sink, "device", audio_device, NULL);
+	}
+
+	gst_bin_add_many(GST_BIN(pipeline), src, conv, vol, sink, NULL);
+	in_bin = TRUE;
+	if (!gst_element_link_many(src, conv, vol, sink, NULL)) {
+		Log_info("gstreamer", "beep: linking failed, tone skipped");
+		goto done;
+	}
+
+	bus = gst_element_get_bus(pipeline);
+	gst_element_set_state(pipeline, GST_STATE_PLAYING);
+	/* Hand the single buffer over, then end the stream so EOS flows and we
+	 * can tear the pipeline down cleanly. */
+	gst_app_src_push_buffer(GST_APP_SRC(src), buf);
+	buf = NULL;	/* ownership moved to appsrc */
+	gst_app_src_end_of_stream(GST_APP_SRC(src));
+
+	/* EOS normally arrives right after the buffer drains; the timeout only
+	 * exists so that a wedged sink cannot leak this thread forever. */
+	msg = gst_bus_timed_pop_filtered(bus,
+			(GstClockTime) (job->duration_ms + 1500) * GST_MSECOND,
+			GST_MESSAGE_EOS | GST_MESSAGE_ERROR);
+	if (msg != NULL) {
+		if (GST_MESSAGE_TYPE(msg) == GST_MESSAGE_EOS) {
+			got_eos = TRUE;
+		} else if (GST_MESSAGE_TYPE(msg) == GST_MESSAGE_ERROR) {
+			GError *err = NULL;
+			gchar *dbg = NULL;
+			gst_message_parse_error(msg, &err, &dbg);
+			Log_info("gstreamer", "beep: %s",
+				 err != NULL ? err->message : "error");
+			if (err != NULL) {
+				g_error_free(err);
+			}
+			g_free(dbg);
+		}
+		gst_message_unref(msg);
+	}
+
+done:
+	if (buf != NULL) {
+		gst_buffer_unref(buf);
+	}
+	if (bus != NULL) {
+		gst_object_unref(bus);
+	}
+	if (in_bin) {
+		if (got_eos) {
+			/* Let dmix push the tail out before the handle goes
+			 * away; closing early chops the tone mid-wave. */
+			g_usleep(150 * 1000);
+		}
+		gst_element_set_state(pipeline, GST_STATE_NULL);
+	} else {
+		beep_unref_all(src, conv, vol, sink, NULL);
+	}
+	if (pipeline != NULL) {
+		gst_object_unref(pipeline);
+	}
+	g_free(job);
+	return NULL;
+}
+
+void output_beep(int which, int duration_ms, float music_gain) {
+	beep_job *job;
+	GThread *thread;
+	double gain;
+
+	if (music_gain <= 0.0f) {
+		return;		/* silent by definition; stay quiet */
+	}
+	/* The tone rides at a fixed ratio below the music. Because the music is
+	 * ducked first (see upnp_control.c), this needs to be loud enough to be
+	 * unmistakable but not so loud that it clips when summed with the ducked
+	 * music: 0.7 * music at full scale sums with 0.4 * music to 1.1, which
+	 * is just over full scale — so cap it at 0.6 so the sum stays ≤ 1.0. */
+	gain = 0.6 * (double) music_gain;
+	if (gain > 0.6) {
+		gain = 0.6;
+	}
+	job = g_new0(beep_job, 1);
+	job->tone = (which != 0) ? &BEEP_FULL : &BEEP_NORMAL;
+	job->duration_ms = duration_ms;
+	job->volume = gain;
+
+	/* Detached: a volume-key burst must never stall the UPnP thread. */
+	thread = g_thread_new("gmr-beep", beep_thread, job);
+	g_thread_unref(thread);
+}
+
