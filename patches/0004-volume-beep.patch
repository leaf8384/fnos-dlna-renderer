+/* Builds ``audiomixer ! audioconvert ! alsasink`` with a silent
+ * audiotestsrc wired into a second mixer input, and hands the mixer's
+ * remaining input to playbin as the bin's sink pad. Returns NULL when
+ * anything is missing, so the caller can fall back to a plain sink. */
+static GstElement *beep_sink_new(const char *sink_name, const char *device) {
+	GstElement *bin, *mix, *aconv, *sink, *tone, *tconv, *tres;
+	GstPad *pad, *peer, *ghost;
+
+	/* Only alsasink takes the device we know about. */
+	if (sink_name == NULL || strcmp(sink_name, "alsasink") != 0) {
+		return NULL;
+	}
+
+	bin   = gst_bin_new("gmr_beep_sink");
+	mix   = gst_element_factory_make("audiomixer", "gmr_mix");
+	aconv = gst_element_factory_make("audioconvert", "gmr_aconv");
+	sink  = gst_element_factory_make("alsasink", "gmr_alsasink");
+	tone  = gst_element_factory_make("audiotestsrc", "gmr_tone");
+	tconv = gst_element_factory_make("audioconvert", "gmr_tconv");
+	tres  = gst_element_factory_make("audioresample", "gmr_tres");
+	if (bin == NULL || mix == NULL || aconv == NULL || sink == NULL ||
+	    tone == NULL || tconv == NULL || tres == NULL) {
+		Log_info("gstreamer", "beep: audiomixer/audiotestsrc missing, "
+			 "continuing without the confirmation tone");
+		if (bin != NULL) {
+			gst_object_unref(bin);
+		}
+		return NULL;
+	}
+
+	if (device != NULL) {
+		g_object_set(sink, "device", device, NULL);
+	}
+	/* Silent until a volume change arrives. */
+	g_object_set(tone,
+		     "wave", 0,		/* sine */
+		     "freq", 880.0,
+		     "volume", 0.0,
+		     "is-live", TRUE,
+		     NULL);
+
+	gst_bin_add_many(GST_BIN(bin), mix, aconv, sink, tone, tconv, tres, NULL);
+	if (!gst_element_link_many(mix, aconv, sink, NULL) ||
+	    !gst_element_link_many(tone, tconv, tres, NULL)) {
+		Log_info("gstreamer", "beep: linking the mixer failed");
+		gst_object_unref(bin);
+		return NULL;
+	}
+
+	pad = gst_element_get_request_pad(mix, "sink_%u");
+	peer = gst_element_get_static_pad(tres, "src");
+	if (pad == NULL || peer == NULL ||
+	    gst_pad_link(peer, pad) != GST_PAD_LINK_OK) {
+		Log_info("gstreamer", "beep: wiring the tone into the mixer failed");
+		if (peer != NULL) {
+			gst_object_unref(peer);
+		}
+		if (pad != NULL) {
+			gst_object_unref(pad);
+		}
+		gst_object_unref(bin);
+		return NULL;
+	}
+	gst_object_unref(peer);
+	gst_object_unref(pad);
+
+	pad = gst_element_get_request_pad(mix, "sink_%u");
+	if (pad == NULL) {
+		gst_object_unref(bin);
+		return NULL;
+	}
+	ghost = gst_ghost_pad_new("sink", pad);
+	gst_object_unref(pad);
+	if (ghost == NULL || !gst_element_add_pad(bin, ghost)) {
+		Log_info("gstreamer", "beep: exposing the mixer sink failed");
+		gst_object_unref(bin);
+		return NULL;
+	}
+
+	beep_src_ = GST_ELEMENT(gst_object_ref(tone));
+	beep_alsasink_ = GST_ELEMENT(gst_object_ref(sink));
+	Log_info("gstreamer", "beep: confirmation tone enabled");
+	return bin;
+}
+
+static gboolean beep_off_cb(gpointer data) {
+	(void)data;
+	beep_off_timer_ = 0;
+	if (beep_src_ != NULL) {
+		g_object_set(beep_src_, "volume", 0.0, NULL);
+	}
+	return G_SOURCE_REMOVE;
+}
+
+void output_beep(int freq_hz, int duration_ms) {
+	if (beep_src_ == NULL) {
+		return;
+	}
+	if (beep_off_timer_ != 0) {
+		g_source_remove(beep_off_timer_);
+		beep_off_timer_ = 0;
+	}
+	g_object_set(beep_src_, "freq", (double) freq_hz,
+		     "volume", 0.5, NULL);
+	beep_off_timer_ = g_timeout_add(duration_ms, beep_off_cb, NULL);
 }
 
