 static void volume_state_save(int level);
+/* defined further down; the confirmation tone needs the same dB curve the
+ * music is played at */
+static float volume_level_to_decibel(int volume);
+
+/* A volume-key press sends one SetVolume, a slider drag sends a burst of
+ * them. Waiting for the value to settle turns that into one beep instead
+ * of a machine gun. */
+#define VOLUME_BEEP_IDLE_MS 400
+
+/* ---- ducking: pull the music down before the tone, ramp it back after.
+ *
+ * Why a ramp instead of a hard step: a step makes the music audibly "cut"
+ * and then snap back, which is exactly the pumping artefact listeners
+ * describe as cheap. A short attack (~30 ms) and a gentler release
+ * (~350 ms) make the dip feel like a breath instead of a glitch.
+ *
+ * Depth is deliberately shallow: the tone itself is what should stand out,
+ * not the hole in the music. -8 dB (×0.4) is enough to clear the tone
+ * without making the music disappear. */
+#define VOLUME_DUCK_GAIN   0.40		/* ×0.4 ≈ -8 dB while ducked */
+#define VOLUME_DUCK_ATTACK_MS 30	/* time to ramp down */
+#define VOLUME_DUCK_HOLD_MS    70	/* time at full duck (covers the tone) */
+#define VOLUME_DUCK_RELEASE_MS 350	/* time to ramp back up */
+#define VOLUME_DUCK_STEP_MS    10	/* ramp tick */
+
+static guint volume_beep_timer_ = 0;
+static guint volume_duck_timer_ = 0;
+static int volume_beep_level_ = -1;
+static double volume_beep_gain_ = 1.0;
+
+/* The very same linear gain the music is played at: level 100 -> 1.0,
+ * level 50 -> 0.1 (that is -20dB, the scale playbin uses), level 0 ->
+ * 0.001. Rendering the tone at a fixed ratio of it keeps the tone the
+ * same distance below the music at every volume, instead of blasting
+ * through at a constant level. */
+static double volume_level_gain(int level) {
+	return exp(volume_level_to_decibel(level) / 20 * log(10));
+}
+
+/* One tick of the ducking ramp. `data` is a pointer to a small struct that
+ * describes where we are going; the callback advances the music gain one
+ * step toward the target and reschedules itself until it arrives. */
+typedef struct {
+	double from;
+	double to;
+	int    step;		/* current step index */
+	int    steps;		/* total steps */
+} duck_ramp;
+
+static gboolean duck_ramp_tick(gpointer data) {
+	duck_ramp *r = (duck_ramp *) data;
+	double t, g;
+	r->step++;
+	if (r->step >= r->steps) {
+		t = 1.0;
+	} else {
+		t = (double) r->step / (double) r->steps;
+	}
+	g = r->from + (r->to - r->from) * t;
+
+	pthread_mutex_lock(&control_mutex);
+	output_set_volume(g);
+	pthread_mutex_unlock(&control_mutex);
+
+	if (r->step >= r->steps) {
+		g_free(r);
+		return G_SOURCE_REMOVE;
+	}
+	return G_SOURCE_CONTINUE;
+}
+
+static void duck_ramp_start(double from, double to, int ms) {
+	duck_ramp *r = g_new0(duck_ramp, 1);
+	int steps = ms / VOLUME_DUCK_STEP_MS;
+	if (steps < 1) {
+		steps = 1;
+	}
+	r->from = from;
+	r->to = to;
+	r->step = 0;
+	r->steps = steps;
+	volume_duck_timer_ = g_timeout_add(VOLUME_DUCK_STEP_MS,
+					   duck_ramp_tick, r);
+}
+
+/* After the attack ramp finishes, the music is at full duck: now is the
+ * moment the tone sounds, so it is not fighting the music. */
+typedef struct {
+	int   level;
+	double gain;
+} duck_then_beep;
+
+static gboolean duck_then_beep_fire(gpointer data) {
+	duck_then_beep *p = (duck_then_beep *) data;
+	/* Full scale gets a distinctly higher (octave-up) tone. */
+	output_beep(p->level >= 100 ? 1 : 0, 70, p->gain);
+	g_free(p);
+	return G_SOURCE_REMOVE;
+}
+
+/* The tone has sounded; wait out the hold, then ramp the music back. */
+static gboolean duck_release_fire(gpointer data) {
+	(void)data;
+	volume_duck_timer_ = 0;
+	duck_ramp_start(volume_beep_gain_ * VOLUME_DUCK_GAIN,
+			volume_beep_gain_, VOLUME_DUCK_RELEASE_MS);
+	return G_SOURCE_REMOVE;
+}
+
+static gboolean volume_beep_fire(gpointer data) {
+	int muted = 0;
+	(void)data;
+	volume_beep_timer_ = 0;
+	/* Nothing is coming out of the speaker, so silence is the honest
+	 * feedback: no tone while stopped, paused or muted. */
+	if (!upnp_transport_is_playing()) {
+		return G_SOURCE_REMOVE;
+	}
+	/* Not service_lock(): that one also brackets a UPnP LastChange
+	 * collection, and we are not changing any variable here. */
+	pthread_mutex_lock(&control_mutex);
+	output_get_mute(&muted);
+	pthread_mutex_unlock(&control_mutex);
+	if (muted) {
+		return G_SOURCE_REMOVE;
+	}
+
+	{
+		duck_then_beep *p = g_new0(duck_then_beep, 1);
+		p->level = volume_beep_level_;
+		p->gain = volume_beep_gain_;
+
+		/* 1) ramp the music down... */
+		duck_ramp_start(volume_beep_gain_,
+				volume_beep_gain_ * VOLUME_DUCK_GAIN,
+				VOLUME_DUCK_ATTACK_MS);
+		/* 2) ...sound the tone once the dip has landed... */
+		g_timeout_add(VOLUME_DUCK_ATTACK_MS + VOLUME_DUCK_STEP_MS,
+			      duck_then_beep_fire, p);
+		/* 3) ...hold, then ramp back up. */
+		g_timeout_add(VOLUME_DUCK_ATTACK_MS + VOLUME_DUCK_HOLD_MS
+			      + VOLUME_DUCK_STEP_MS,
+			      duck_release_fire, NULL);
+	}
+	return G_SOURCE_REMOVE;
+}
 
 static void change_volume(const char *volume, const char *db_volume) {
 	replace_var(CONTROL_VAR_VOLUME, volume);
 	replace_var(CONTROL_VAR_VOLUME_DB, db_volume);
 	volume_state_save(atoi(volume));
+
+	volume_beep_level_ = atoi(volume);
+	volume_beep_gain_ = volume_level_gain(volume_beep_level_);
+	/* A new value while the music is still ducked: the caller is about
+	 * to set the real volume anyway, so drop any pending ramp and just
+	 * let the new value land (the ramp tick writes the *current* target,
+	 * so cancelling it leaves the music at whatever the new SetVolume
+	 * already wrote). */
+	if (volume_duck_timer_ != 0) {
+		g_source_remove(volume_duck_timer_);
+		volume_duck_timer_ = 0;
+	}
+	if (volume_beep_timer_ != 0) {
+		g_source_remove(volume_beep_timer_);
+		volume_beep_timer_ = 0;
+	}
+	volume_beep_timer_ = g_timeout_add(VOLUME_BEEP_IDLE_MS,
+					   volume_beep_fire, NULL);
 }
 
