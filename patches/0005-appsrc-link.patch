--- a/configure.ac
+++ b/configure.ac
@@ -82,6 +82,23 @@
 AC_SUBST(HAVE_GST)
 AM_CONDITIONAL(HAVE_GST, test x$HAVE_GST = xyes)
 
+# appsrc lives in gstreamer-plugins-base, not the core. We need it to feed
+# the hand-built confirmation-tone PCM into the beep pipeline. It is a hard
+# requirement for the GStreamer output; without it the tone silently
+# disappears, so fail the build rather than ship a half-working renderer.
+if test x$HAVE_GST = xyes; then
+  PKG_CHECK_MODULES(GSTAPP, gstreamer-app-1.0 >= 1.0,
+    [
+      AC_SUBST(GSTAPP_CFLAGS)
+      AC_SUBST(GSTAPP_LIBS)
+    ],
+    [
+      AC_MSG_ERROR([gstreamer-app-1.0 (appsrc) is required for the GStreamer output; install libgstreamer-plugins-base1.0-dev])
+    ])
+  GST_CFLAGS="$GST_CFLAGS $GSTAPP_CFLAGS"
+  GST_LIBS="$GST_LIBS $GSTAPP_LIBS"
+fi
+
 
 LIBUPNP_REQUIRED=1.6.0
 AC_ARG_WITH( libupnp,
