+/* Invoked under service_lock by SOAP handlers. Repeated identical targets
+ * do not postpone the acknowledgement indefinitely. */
+static void volume_request_locked(int level, double gain) {
+	float current = gain;
+	int muted = 0;
+	volume_transition *t;
+	output_get_mute(&muted);
+	if (level == volume_target_level_ && gain == volume_target_gain_ &&
+	    (level == 0 || !muted)) return;
+	volume_cancel_locked();
+	volume_target_level_ = level;
+	volume_target_gain_ = gain;
+	output_get_volume(&current);
+	t = g_new0(volume_transition, 1);
+	t->generation = volume_generation_;
+	t->transport_generation = upnp_transport_generation();
+	t->from = current;
+	t->to = gain;
+	t->level = level;
+	if (muted || !upnp_transport_is_playing()) {
+		volume_finish_locked(t);
+		g_free(t);
+		return;
+	}
+	volume_timer_ = g_timeout_add_full(G_PRIORITY_DEFAULT, VOLUME_SETTLE_MS,
+		volume_settle_fire, t, g_free);
