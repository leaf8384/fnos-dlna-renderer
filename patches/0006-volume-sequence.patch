+		if (muted || !upnp_transport_is_playing() ||
+		    t->transport_generation != upnp_transport_generation()) {
+			volume_finish_locked(t);
+		} else {
+			volume_transition *job = g_new0(volume_transition, 1);
+			*job = *t;
